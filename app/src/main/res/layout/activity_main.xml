<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020617">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom_nav_bar"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. Header -->
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                    <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@android:drawable/ic_dialog_map" app:tint="#0EA5E9" />
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-condensed" android:letterSpacing="0.05" android:text="MINEGUARD" android:textColor="#0EA5E9" android:textSize="18sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-condensed" android:text="SAFER MINES • SMARTER TOMORROW" android:textColor="#64748B" android:textSize="8sp" />
                    </LinearLayout>
                </LinearLayout>
                
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    app:cardBackgroundColor="#0B1524"
                    app:cardCornerRadius="8dp"
                    app:strokeColor="#163859"
                    app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="6dp">
                        <View android:layout_width="8dp" android:layout_height="8dp" android:layout_gravity="center_vertical" android:background="#22C55E" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:fontFamily="sans-serif-condensed" android:text="ONLINE\n24/7 ACTIVE" android:textColor="#22C55E" android:textSize="8sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </RelativeLayout>

            <!-- 2. Officer Profile Row -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal" android:weightSum="2">
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="#0B1524"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="#163859"
                    app:strokeWidth="1.5dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_menu_myplaces" app:tint="#94A3B8" />
                        <TextView android:id="@+id/tv_officer_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:fontFamily="sans-serif-condensed" android:text="Gaurav Yadav\nMining Sirdar" android:textColor="#F8FAFC" android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardBackgroundColor="#0B1524"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="#163859"
                    app:strokeWidth="1.5dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_menu_mylocation" app:tint="#0EA5E9" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:fontFamily="sans-serif-condensed" android:text="Mine Site\nBlock A - Seam 3" android:textColor="#0EA5E9" android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- 3. Telemetry HUD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_telemetry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#0B1524"
                app:cardCornerRadius="12dp"
                app:strokeColor="#163859"
                app:strokeWidth="1.5dp">
                
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-condensed" android:letterSpacing="0.05" android:text="[ ATMOSPHERIC TELEMETRY ]" android:textColor="#F8FAFC" android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:background="#166534" android:fontFamily="sans-serif-condensed" android:paddingHorizontal="6dp" android:text="LIVE" android:textColor="#4ADE80" android:textSize="10sp" android:textStyle="bold" />
                    </RelativeLayout>
                    
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal" android:weightSum="2">
                        <com.mineguard.dgms.ui.NeonGaugeView
                            android:id="@+id/gauge_ch4"
                            android:layout_width="0dp"
                            android:layout_height="140dp"
                            android:layout_weight="0.8" />
                            
                        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="12dp" android:layout_weight="1.2" android:gravity="center_vertical" android:orientation="vertical">
                            <TextView android:id="@+id/tv_sensor_ch4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-condensed" android:text="[ CH4 ] Methane\n0.12% (Safe)" android:textColor="#0EA5E9" android:textSize="12sp" />
                            <TextView android:id="@+id/tv_sensor_co" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:fontFamily="sans-serif-condensed" android:text="[ CO ] Carbon Monoxide\n0 PPM (Safe)" android:textColor="#0EA5E9" android:textSize="12sp" />
                            <TextView android:id="@+id/tv_sensor_o2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:fontFamily="sans-serif-condensed" android:text="[ O2 ] Oxygen\n20.9% (Normal)" android:textColor="#0EA5E9" android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. Mesh Sonar -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#0B1524"
                app:cardCornerRadius="12dp"
                app:strokeColor="#163859"
                app:strokeWidth="1.5dp">
                
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-condensed" android:letterSpacing="0.05" android:text="[ MESH SONAR PULSE ]" android:textColor="#F8FAFC" android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tv_peer_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:fontFamily="sans-serif-condensed" android:text="3 Peers Linked | BLE" android:textColor="#0EA5E9" android:textSize="10sp" />
                    </RelativeLayout>
                    
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal">
                        <TextView android:id="@+id/tv_sonar_nodes" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="monospace" android:text="O YOU --- O RAMESH --- O VIKAS" android:textColor="#0EA5E9" android:textSize="10sp" />
                        <LinearLayout android:layout_width="100dp" android:layout_height="wrap_content" android:background="#071A2F" android:orientation="vertical" android:padding="8dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-condensed" android:text="NEAREST" android:textColor="#94A3B8" android:textSize="9sp" />
                            <TextView android:id="@+id/tv_nearest_miner" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-condensed" android:text="Vikas (Overman)" android:textColor="#F8FAFC" android:textSize="11sp" />
                            <TextView android:id="@+id/tv_nearest_dist" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-condensed" android:text="» 12m away" android:textColor="#22C55E" android:textSize="12sp" android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 5. Bento Grid -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal" android:weightSum="2">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_attendance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#0B1524"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="#163859"
                    app:strokeWidth="1.5dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-condensed" android:letterSpacing="0.05" android:text="[ FORM B MANPOWER ]" android:textColor="#F8FAFC" android:textSize="10sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tv_manpower_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="sans-serif-condensed" android:text="42 / 45 Active" android:textColor="#22C55E" android:textSize="20sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_strata"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#0B1524"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="#163859"
                    app:strokeWidth="1.5dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-condensed" android:letterSpacing="0.05" android:text="[ STRATA STRESS ]" android:textColor="#F8FAFC" android:textSize="10sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tv_strata_load" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="sans-serif-condensed" android:text="8.6T  SECURE" android:textColor="#0EA5E9" android:textSize="20sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- 6. Real SOS Tactical Slider -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#450A0A"
                app:cardCornerRadius="12dp"
                app:strokeColor="#DC2626"
                app:strokeWidth="2dp">
                
                <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="0.1"
                        android:text="» SLIDE TO TRIGGER SOS EVACUATION »"
                        android:textColor="#FCA5A5"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                        
                    <SeekBar
                        android:id="@+id/seek_sos_slider"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@null"
                        android:thumbTint="#FFFFFF"
                        android:splitTrack="false" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- INLINED BOTTOM NAV BAR -->
    <LinearLayout
        android:id="@+id/bottom_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:background="#020617"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:weightSum="4">
        
        <LinearLayout android:id="@+id/nav_home" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/ic_menu_compass" app:tint="#0EA5E9" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-condensed" android:text="HUD" android:textColor="#0EA5E9" android:textSize="10sp" />
        </LinearLayout>
        
        <LinearLayout android:id="@+id/nav_map" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/ic_menu_mylocation" app:tint="#64748B" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-condensed" android:text="RADAR" android:textColor="#64748B" android:textSize="10sp" />
        </LinearLayout>
        
        <LinearLayout android:id="@+id/nav_reports" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/ic_menu_agenda" app:tint="#64748B" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-condensed" android:text="LOGS" android:textColor="#64748B" android:textSize="10sp" />
        </LinearLayout>
        
        <LinearLayout android:id="@+id/dock_btn_pdf" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/ic_menu_save" app:tint="#F59E0B" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-condensed" android:text="PDF" android:textColor="#F59E0B" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>

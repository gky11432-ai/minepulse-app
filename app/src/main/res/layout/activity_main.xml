<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050B14">

    <!-- MAIN DASHBOARD CONTENT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Original Top Toolbar with Torch & Menu -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/top_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#0A1424"
            app:navigationIcon="@android:drawable/ic_menu_sort_by_size"
            app:navigationIconTint="#38BDF8"
            app:title="MINEGUARD"
            app:titleTextColor="#38BDF8">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_torch_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:backgroundTint="#162A45"
                    android:text="🔦 Torch"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    app:cornerRadius="18dp" />
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <!-- Live Shift & Mesh Strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#08101D"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/tv_shift_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⏱️ SHIFT 1 (06:00 - 14:00)"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_mesh_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟢 OFFLINE MESH READY"
                android:textColor="#22C55E"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1. Live Gas & Ventilation Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_gas_audit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#0D1929"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="#1B426B"
                    app:strokeWidth="1.2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="💨 CMR 153: MINE ATMOSPHERE"
                                android:textColor="#38BDF8"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tv_gas_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:background="#162A45"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="2dp"
                                android:text="SAFE"
                                android:textColor="#22C55E"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <TextView
                            android:id="@+id/tv_gas_readout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="CH4: 0.00% | CO: 0 PPM | Airflow Normal"
                            android:textColor="#E2E8F0"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. Dual Bento: Attendance & Strata -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <!-- Form B Attendance -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_attendance"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#0D1929"
                        app:cardCornerRadius="12dp"
                        app:strokeColor="#1B426B"
                        app:strokeWidth="1.2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="10dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⏱️ FORM B ROLL"
                                android:textColor="#38BDF8"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tv_manpower_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="0 Miners Active"
                                android:textColor="#22C55E"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- CMR 123 Strata -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_strata"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#0D1929"
                        app:cardCornerRadius="12dp"
                        app:strokeColor="#1B426B"
                        app:strokeWidth="1.2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="10dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🪨 STRATA (CMR 123)"
                                android:textColor="#38BDF8"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tv_strata_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Roof: Stable (Normal)"
                                android:textColor="#E2E8F0"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- 3. Real Live BLE Mesh Sonar -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_radar_open"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="#0D1929"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="#1B426B"
                    app:strokeWidth="1.2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tv_sonar_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📡 OFFLINE RADAR &amp; TRACKING"
                            android:textColor="#38BDF8"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_sonar_detail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="🔍 खदान में आसपास साथियों की खोज जारी..."
                            android:textColor="#94A3B8"
                            android:textSize="10sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 4. Tactical Emergency Siren Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_emergency_siren"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="#450A0A"
                    app:cardCornerRadius="14dp"
                    app:strokeColor="#EF4444"
                    app:strokeWidth="1.5dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingHorizontal="14dp">

                        <TextView
                            android:id="@+id/tv_siren_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:text="🚨 TAP TO BROADCAST COLLIERY SIREN"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:text="SOS 🏃"
                            android:textColor="#FCA5A5"
                            android:textSize="13sp" />
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 5. Master Shift Dossier Print Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_print_master"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#1E1B4B"
                    android:text="🖨️ PRINT MASTER DOSSIER (FORM 6 &amp; LOGS)"
                    android:textColor="#A5B4FC"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp"
                    app:strokeColor="#6366F1"
                    app:strokeWidth="1.2dp" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Original Navigation Drawer View -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#0A1424"
        app:itemTextColor="#CBD5E1"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>

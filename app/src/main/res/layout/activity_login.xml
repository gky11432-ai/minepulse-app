<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020617"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⛑️"
            android:textSize="54sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="MINEGUARD AUTHENTICATION"
            android:textColor="#38bdf8"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="DGMS Statutory Officer Verification (Mines Act 1952)"
            android:textColor="#94a3b8"
            android:textSize="11sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="#0f172a"
            app:cardCornerRadius="16dp"
            app:strokeColor="#1e293b"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <EditText
                    android:id="@+id/et_login_name"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#020617"
                    android:hint="Full Name (अफ़सर का नाम)"
                    android:paddingHorizontal="14dp"
                    android:textColor="#f8fafc"
                    android:textColorHint="#64748b"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/et_login_id"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="#020617"
                    android:hint="Employee / Certificate ID (e.g. S-9402)"
                    android:paddingHorizontal="14dp"
                    android:textColor="#f8fafc"
                    android:textColorHint="#64748b"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Designation / वैधानिक पद:"
                    android:textColor="#94a3b8"
                    android:textSize="11sp" />

                <Spinner
                    android:id="@+id/sp_login_role"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:background="#020617" />

                <EditText
                    android:id="@+id/et_login_pin"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="#020617"
                    android:hint="4-Digit Security PIN (सुरक्षा पिन)"
                    android:inputType="numberPassword"
                    android:maxLength="4"
                    android:paddingHorizontal="14dp"
                    android:textColor="#f8fafc"
                    android:textColorHint="#64748b"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_submit_login"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="#0284c7"
                    android:text="AUTHORISE &amp; ENTER"
                    android:textColor="#ffffff"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>

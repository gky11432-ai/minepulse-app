<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Bento Tiles (Manpower & Strata) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:weightSum="2">

        <!-- Form B Manpower -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cyber_card"
            android:orientation="vertical"
            android:padding="10dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👥 FORM B MANPOWER"
                android:textColor="#E2E8F0"
                android:textSize="9sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="42 / 45 Active"
                android:textColor="#22C55E"
                android:textSize="15sp"
                android:textStyle="bold" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_roll_call"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="#0F243A"
                android:text="+ Roll Call"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                app:cornerRadius="6dp" />
        </LinearLayout>

        <!-- Strata Stress -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cyber_card"
            android:orientation="vertical"
            android:padding="10dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🪨 STRATA STRESS"
                android:textColor="#E2E8F0"
                android:textSize="9sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="8.6T • SECURE"
                android:textColor="#38BDF8"
                android:textSize="15sp"
                android:textStyle="bold" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_roof_log"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="#0F243A"
                android:text="🔍 Roof Log"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                app:cornerRadius="6dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tactical SOS Action Bar -->
    <LinearLayout
        android:id="@+id/card_sos_action"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_sos_tactical"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️"
            android:textSize="18sp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text=">> SLIDE TO TRIGGER SOS EVACUATION >>"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏃💨"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Floating Dock (Radar, Logs, PDF) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_cyber_card"
        android:orientation="vertical"
        android:padding="10dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛟 FLOATING DOCK"
            android:textColor="#64748B"
            android:textSize="9sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:weightSum="3">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/dock_btn_radar"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:backgroundTint="#0F243A"
                android:text="📡 Radar"
                android:textColor="#38BDF8"
                android:textSize="9sp"
                app:cornerRadius="6dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/dock_btn_logs"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:backgroundTint="#0F243A"
                android:text="📋 Logs"
                android:textColor="#A855F7"
                android:textSize="9sp"
                app:cornerRadius="6dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/dock_btn_pdf"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:backgroundTint="#0F243A"
                android:text="🖨️ PDF"
                android:textColor="#F59E0B"
                android:textSize="9sp"
                app:cornerRadius="6dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>

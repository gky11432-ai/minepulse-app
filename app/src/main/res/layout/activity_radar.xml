<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020617"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📍 P2P UNDERGROUND RADAR"
        android:textColor="#38bdf8"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Real-time proximity via BLE signal mesh (Zero Internet / No GPS)"
        android:textColor="#94a3b8"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/tv_radar_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#0f172a"
        android:padding="10dp"
        android:text="⚡ Scanning Nearby Miners..."
        android:textColor="#34d399"
        android:textSize="12sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/lv_miners"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="12dp"
        android:divider="#1e293b"
        android:dividerHeight="1dp" />

</LinearLayout>

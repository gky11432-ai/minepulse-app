<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050B14">

    <!-- Top Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/top_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#0A1424"
        app:title="BLE MESH RADAR"
        app:titleTextColor="#38BDF8"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:navigationIconTint="#38BDF8"/>

    <!-- Radar Surface -->
    <com.mineguard.dgms.RadarView
        android:id="@+id/radar_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top_toolbar"
        android:layout_above="@+id/bottom_nav_bar_include" />

    <!-- Status Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/bottom_nav_bar_include"
        android:background="#D9050B14"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OFFLINE TRACKING ENGAGED"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_radar_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Scanning for nearby miners using Bluetooth Mesh..."
            android:textColor="#94A3B8"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- NEW UNIVERSAL BOTTOM NAV (Included via file) -->
    <include
        android:id="@+id/bottom_nav_bar_include"
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" />

</RelativeLayout>

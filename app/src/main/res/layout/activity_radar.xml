<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050B14">

    <!-- Top Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/top_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#0A1424"
        app:title="BLE MESH RADAR"
        app:titleTextColor="#38BDF8"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:navigationIconTint="#38BDF8"/>

    <!-- Radar Surface -->
    <com.mineguard.dgms.RadarView
        android:id="@+id/radar_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top_toolbar"
        android:layout_above="@+id/bottom_nav_bar" />

    <!-- Status Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/bottom_nav_bar"
        android:background="#D9050B14"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OFFLINE TRACKING ENGAGED"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_radar_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Scanning for nearby miners using Bluetooth Mesh..."
            android:textColor="#94A3B8"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- INLINED BOTTOM NAV BAR -->
    <LinearLayout
        android:id="@+id/bottom_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:background="#020617"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:weightSum="4">
        
        <LinearLayout android:id="@+id/nav_home" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/ic_menu_compass" app:tint="#64748B" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-condensed" android:text="HUD" android:textColor="#64748B" android:textSize="10sp" />
        </LinearLayout>
        
        <LinearLayout android:id="@+id/nav_map" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/ic_menu_mylocation" app:tint="#0EA5E9" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-condensed" android:text="RADAR" android:textColor="#0EA5E9" android:textSize="10sp" />
        </LinearLayout>
        
        <LinearLayout android:id="@+id/nav_reports" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/ic_menu_agenda" app:tint="#64748B" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-condensed" android:text="LOGS" android:textColor="#64748B" android:textSize="10sp" />
        </LinearLayout>
        
        <LinearLayout android:id="@+id/dock_btn_pdf" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/ic_menu_save" app:tint="#F59E0B" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-condensed" android:text="PDF" android:textColor="#F59E0B" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
